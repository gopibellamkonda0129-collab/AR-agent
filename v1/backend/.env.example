# Copy to .env and fill in. AR_DEMO=1 runs fully offline with synthetic data.
AR_DEMO=0

# ---- persistence: Supabase/Postgres (apply supabase/schema.sql first) ----
# SUPABASE_URL=https://your-ref.supabase.co
# SUPABASE_KEY=your-service-role-key

# ---- AI analysis (optional; falls back to the built-in rule engine) ----
# OPENAI_API_KEY=sk-...

# ---- inboxes ----------------------------------------------------------
# Gmail OAuth requires a Google Cloud project with the Gmail API enabled.
# Download the OAuth client secrets and place at:
GMAIL_CLIENT_SECRET=gmail_client_secret.json
OUTLOOK_CLIENT_SECRET=outlook_client_secret.json

# ---- background auto-sync (seconds between polls, 0 disables) ----------
AR_SYNC_INTERVAL=300

# ---- path to the V0 ar_agent package (invoice importers) ---------------
# AR_V0_DIR=C:\Users\gopik\Downloads\AI\ar_agent